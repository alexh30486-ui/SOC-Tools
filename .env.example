# Local preview (fully works without Supabase or Redis)
SPEC_DATABASE_URL=sqlite:///spec-dev.db
SPEC_SECRET=replace-with-unique-64-character-random-secret
SOC_STORAGE=local
SOC_QUEUE=inline

# Optional server-side Supabase persistence. Never expose SOC_SUPABASE_SECRET_KEY in JS.
# SOC_STORAGE=supabase
# SOC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# SOC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# SOC_SUPABASE_SECRET_KEY=sb_secret_...

# Optional Redis queue: requires Redis 7+ and separate soc_worker process.
# SOC_QUEUE=redis
# SOC_REDIS_URL=redis://localhost:6379/0
# Production Redis should be on a private network or use TLS (rediss://).

# Network Diagnostics terminal — OFF by default. All probes originate from the API server.
# Set only for a network you own or are authorized to test.
# SPEC_NET_DIAGNOSTICS_ENABLED=1
# SPEC_NET_ALLOWED_TARGETS=127.0.0.1/32,::1/128,localhost
# SPEC_NET_ALLOWED_PORTS=53,443,5300,8080
# The terminal accepts help, status, ping HOST, dns HOST, tcp HOST PORT,
# udp HOST PORT. No arbitrary shell, packet capture or port ranges.
